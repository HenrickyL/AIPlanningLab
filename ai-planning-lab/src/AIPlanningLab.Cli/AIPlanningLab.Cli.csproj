<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AIPlanningLab.Application\AIPlanningLab.Application.csproj" />
    <ProjectReference Include="..\AIPlanningLab.Infrastructure\AIPlanningLab.Infrastructure.csproj" />
    <ProjectReference Include="..\AIPlanningLab.Implementations\AIPlanningLab.Implementations.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\samples\problems\**\*.txt">
      <Link>samples\problems\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
